# vllm-embedding settings. Copy to env/.env.vllm-embedding and fill in. Never commit the real file.

# Hugging Face embedding model to serve (vLLM runs it with --runner pooling --convert embed).
VLLM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# Fraction of GPU memory vLLM may use (0-1). Keep it low when the host vLLM chat server shares the GPU.
VLLM_EMBED_GPU_MEM_UTIL=0.10

# Max sequence length in tokens.
VLLM_EMBED_MAX_MODEL_LEN=8192

# Hugging Face token. Only needed for gated or private models. Leave unset for public models.
# HF_TOKEN=
